{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "node init && pnpm -r --parallel run dev",
    "test": "pnpm contracts:test && pnpm -r --filter \"./artifacts/**\" --if-present run test",
    "build": "node init && pnpm run typecheck && pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "deploy:testnet": "pnpm --filter @workspace/contracts run deploy --network baseSepolia",
    "contracts:test": "pnpm --filter @workspace/contracts test",
    "contracts:deploy": "pnpm --filter @workspace/contracts run deploy",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
