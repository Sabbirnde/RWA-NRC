# Protocol Environment Variables Template

# Blockchain RPC & Private Keys
RPC_URL=https://sepolia.base.org
PRIVATE_KEY=your_private_key_here
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here
ATTESTER_PRIVATE_KEY=your_attester_private_key_here

# External Data & Ingestion
FIRECRAWL_API_KEY=fc-YOUR_FIRECRAWL_API_KEY
MAX_DATA_AGE_SECONDS=300

# Backend API & Database Configuration
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rwa_protocol

# Frontend Network Configuration
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ORACLE_ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CLAIM_MARKET_ADDRESS=0x0000000000000000000000000000000000000000
